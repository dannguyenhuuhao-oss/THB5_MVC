@{
    ViewData["Title"] = "Thông tin liên hệ";
}

<h2>THÔNG TIN ĐÃ NHẬP</h2>

<table border="1" cellpadding="8">

    <tr>
        <td>Chủ đề</td>
        <td>@ViewBag.ChuDe</td>
    </tr>

    <tr>
        <td>Tiêu đề</td>
        <td>@ViewBag.TieuDe</td>
    </tr>

    <tr>
        <td>Nội dung</td>
        <td>@ViewBag.NoiDung</td>
    </tr>

    <tr>
        <td>Họ và tên</td>
        <td>@ViewBag.HoTen</td>
    </tr>

    <tr>
        <td>Email</td>
        <td>@ViewBag.Email</td>
    </tr>

    <tr>
        <td>Số điện thoại</td>
        <td>@ViewBag.SoDienThoai</td>
    </tr>

</table>

<br>

<a href="/LienHe">
    Quay lại
</a>