@{
    ViewData["Title"] = "Thêm điện thoại";
}

<h2>THÊM ĐIỆN THOẠI</h2>

<form method="post">

    <table border="1" cellpadding="8">

        <tr>
            <td>Tên điện thoại</td>
            <td>
                <input type="text" name="tenDienThoai">
            </td>
        </tr>

        <tr>
            <td>Hãng</td>
            <td>
                <input type="text" name="hang">
            </td>
        </tr>

        <tr>
            <td>Giá</td>
            <td>
                <input type="number" name="gia">
            </td>
        </tr>

        <tr>
            <td>Màu sắc</td>
            <td>
                <input type="text" name="mauSac">
            </td>
        </tr>

        <tr>
            <td></td>
            <td>
                <button type="submit">Thêm</button>
            </td>
        </tr>

    </table>

</form>